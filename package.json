{
  "name": "spaceguard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run test:server && npm run build",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm run dev\" \"npm run dev:server\"",
    "install:all": "npm install && npm --prefix server install",
    "seed": "npm --prefix server run seed",
    "test:server": "npm --prefix server test"
  },
  "dependencies": {
    "lucide-react": "1.44.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "daisyui": "5.7.36",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "concurrently": "^9.1.2"
  }
}
